# Application
# Local development defaults to this origin when SITE_URL is blank. Production
# must set its canonical HTTP/HTTPS origin explicitly.
SITE_URL=http://localhost:3000

# Supabase
# Public Supabase project origin used by the server (for example,
# https://your-project-ref.supabase.co). This URL is not a credential.
SUPABASE_URL=
# Browser-visible project origin used to validate Rich Content image URLs.
# It must be the same origin as SUPABASE_URL and must never contain a secret.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only Supabase secret used by the application repositories.
# Obtain it from the maintainer only when your task needs database access.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile registration protection
# Browser-visible site key. It is safe for client code, but use the key for the
# intended local/development environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Turnstile secret paired with the site key above.
TURNSTILE_SECRET_KEY=

# Transactional email (Brevo)
# These are only needed for flows that send verification email. Unrelated
# pages can run without them. Never request or reuse the Production API key.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Feature-specific server configuration
# Required only when an Admin generates membership registration keys. Use a
# maintainer-provided value of at least 16 characters; do not invent a shared
# project secret.
REGISTER_KEY_SECRET=
